# ============================================================================
# This template is committed to the repo.
# The real .env lives ONLY on hpg5 at C:\shifts-manager\.env per CLAUDE.md.
# NEVER commit real secrets. Copy this file to .env and fill in values.
# ============================================================================

# --- Postgres ---
# Database name, user, and password for the shifts Postgres instance.
# POSTGRES_USER and POSTGRES_DB default to 'shifts'; POSTGRES_PASSWORD is required.
POSTGRES_USER=shifts
POSTGRES_PASSWORD=changeme-to-a-strong-random-string
POSTGRES_DB=shifts
# Dedicated SUPERUSER role used by the `migrate` service. The app role `shifts`
# is NOSUPERUSER so it cannot bypass RLS via `SET row_security = off`.
# Create the role + grant once with the bootstrap SQL in db/migrations/0001_*.sql.
MIGRATOR_PASSWORD=changeme-to-a-strong-random-string

# DATABASE_URL — consumed by the Next.js app (Drizzle) and any local tooling.
# Inside docker compose use host=postgres; on the dev host use host=localhost
# (only if a host port is published — by default Postgres is internal-only).
DATABASE_URL=postgres://shifts:changeme-to-a-strong-random-string@postgres:5432/shifts?sslmode=disable

# --- Auth.js / NextAuth ---
# NEXTAUTH_SECRET — used to sign JWTs / session cookies. Generate with:
#   openssl rand -hex 32      (or PowerShell: [Convert]::ToHexString((1..32 | %{Get-Random -Max 256})))
NEXTAUTH_SECRET=changeme-32-byte-hex
# NEXTAUTH_URL — public base URL the app is reached at. Local dev: http://localhost:3000.
# Production: https://apps.nesher.co (Cloudflare Tunnel).
NEXTAUTH_URL=http://localhost:3000

# --- Resend (magic-link email for Auth.js EmailProvider) ---
# Source: Resend dashboard -> API Keys -> Create -> copy `re_...` token
RESEND_API_KEY=re_placeholder_provision_when_wiring_auth
# Source: Set to a verified sender on your Resend domain (shifty@nesher.co once domain is provisioned).
RESEND_FROM_EMAIL=shifty@nesher.co
