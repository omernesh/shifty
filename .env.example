# ============================================================================
# Currently active (required for the running Lowdefy + Postgres stack on hpg5)
# ============================================================================

POSTGRES_DB=shifts
POSTGRES_USER=shifts
# Generate a strong password and put it here. Do NOT commit the real .env.
POSTGRES_PASSWORD=changeme-to-a-strong-random-string

# Lowdefy uses Auth.js (NextAuth). Generate a random secret:
#   openssl rand -base64 32
NEXTAUTH_SECRET=changeme-to-a-32-byte-base64-string

# Public URL Lowdefy is reachable at (used by NextAuth for callback URLs).
NEXTAUTH_URL=https://apps.nesher.co

# ============================================================================
# Planned for v1 (see docs/PRD.md §17). Uncomment as each integration ships.
# ============================================================================

# --- Resend (transactional email) ---
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=shifty@nesher.co

# --- WAHA (self-hosted WhatsApp HTTP API; see https://waha.devlikeapro.com) ---
# WAHA_BASE_URL=http://waha:3000
# WAHA_API_KEY=changeme

# --- Web Push (PWA browser notifications) ---
# Generate VAPID keys: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:omernesher@gmail.com

# --- Solver service (FastAPI + OR-Tools CP-SAT, see solver/) ---
# SOLVER_BASE_URL=http://solver:8000
# SOLVER_MAX_SECONDS=10

# --- App defaults ---
# APP_DEFAULT_LOCALE=he
# APP_DEFAULT_TIMEZONE=Asia/Jerusalem

# --- Cron service (daily/weekly digest dispatch) ---
# CRON_DAILY_REPORT_HOUR=7
# CRON_WEEKLY_DIGEST_DOW=MON
# CRON_WEEKLY_DIGEST_HOUR=8
