# ============================================================================
# This template is committed to the repo.
# The real .env lives ONLY on hpg5 at C:\shifts-manager\.env per CLAUDE.md.
# NEVER commit real secrets. Copy this file to .env and fill in values.
# ============================================================================

# --- Postgres ---
# Database name, user, and password for the shifts Postgres instance.
# POSTGRES_USER and POSTGRES_DB default to 'shifts'; POSTGRES_PASSWORD is required.
POSTGRES_USER=shifts
POSTGRES_PASSWORD=changeme-to-a-strong-random-string
POSTGRES_DB=shifts
# Dedicated SUPERUSER role used by the `migrate` service. The app role `shifts`
# is NOSUPERUSER so it cannot bypass RLS via `SET row_security = off`.
# Create the role + grant once with the bootstrap SQL in db/migrations/0001_*.sql.
MIGRATOR_PASSWORD=changeme-to-a-strong-random-string

# --- Budibase self-hosted (added 2026-05-16) ---
# All values must be replaced with fresh random strings. Generate with:
#   openssl rand -hex 32      (or PowerShell: New-Guid; for hex use RandomNumberGenerator)
# These are consumed by 6 services in docker-compose.yml: app, worker, couchdb,
# redis, minio, proxy. Budibase metadata (apps, screens, data sources, users)
# lives in CouchDB; Postgres above remains the Shifty business-data source.

# Builder + tenant secrets — must be unique per deployment.
JWT_SECRET=changeme-32-byte-hex
API_ENCRYPTION_KEY=changeme-32-byte-hex
INTERNAL_API_KEY=changeme-32-byte-hex

# CouchDB credentials — Budibase metadata store.
COUCH_DB_USER=budibase
COUCH_DB_PASSWORD=changeme-32-byte-hex

# Redis password — used by app + worker + proxy.
REDIS_PASSWORD=changeme-32-byte-hex

# MinIO — Budibase's S3-compatible object store (attachments, uploads).
MINIO_ACCESS_KEY=changeme-32-byte-hex
MINIO_SECRET_KEY=changeme-32-byte-hex

# --- Resend (Phase 1 magic-link email — required by Plan 03) ---
# Source: Resend dashboard -> API Keys -> Create -> copy `re_...` token
RESEND_API_KEY=re_placeholder_provision_in_plan_03
# Source: Set to a verified sender on your Resend domain (shifty@nesher.co once domain is provisioned).
RESEND_FROM_EMAIL=shifty@nesher.co
