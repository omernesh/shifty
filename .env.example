POSTGRES_DB=shifts
POSTGRES_USER=shifts
# Generate a strong password and put it here. Do NOT commit the real .env.
POSTGRES_PASSWORD=changeme-to-a-strong-random-string

# Lowdefy uses Auth.js (NextAuth). Generate a random secret:
#   openssl rand -base64 32
NEXTAUTH_SECRET=changeme-to-a-32-byte-base64-string

# Public URL Lowdefy is reachable at (used by NextAuth for callback URLs).
NEXTAUTH_URL=https://apps.nesher.co
