# pnpm configuration for Lowdefy Docker build compatibility
# shamefully-hoist=true makes all packages available in node_modules/ as direct symlinks.
# This is needed for Lowdefy's internal @lowdefy/server build step which runs scripts
# from .lowdefy/server/ and expects to find dependencies (like 'yargs') by traversing
# up the directory tree. Without hoisting, pnpm uses virtual stores that aren't
# visible to scripts outside their package context.
shamefully-hoist=true
