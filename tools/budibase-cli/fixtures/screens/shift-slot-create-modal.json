{
  "name": "shift-slot-create-modal",
  "workspaceAppId": "{{workspaceAppId}}",
  "showNavigation": true,
  "width": "Medium",
  "routing": { "route": "/shift-slots/new", "roleId": "ADMIN", "homeScreen": false },
  "props": {
    "_id": "cmp_create_modal_root",
    "_component": "@budibase/standard-components/container",
    "_styles": { "normal": { "padding": "24px" }, "hover": {}, "active": {}, "selected": {} },
    "_instanceName": "Create modal route root",
    "layout": "flex",
    "direction": "column",
    "hAlign": "stretch",
    "vAlign": "top",
    "size": "grow",
    "gap": "M",
    "_children": [
      {
        "_id": "cmp_create_route_heading",
        "_component": "@budibase/standard-components/heading",
        "_styles": { "normal": { "text-align": "right" }, "hover": {}, "active": {}, "selected": {} },
        "_instanceName": "Heading",
        "_children": [],
        "text": "יצירת משמרת",
        "size": "L"
      },
      {
        "_id": "cmp_create_route_hint",
        "_component": "@budibase/standard-components/text",
        "_styles": { "normal": { "text-align": "right" }, "hover": {}, "active": {}, "selected": {} },
        "_instanceName": "Hint text",
        "_children": [],
        "text": "המודאל לדף יצירת משמרת מוטמע בדף הראשי. חזור לרשימה כדי ליצור משמרת חדשה."
      },
      {
        "_id": "cmp_create_route_back",
        "_component": "@budibase/standard-components/button",
        "_styles": { "normal": {}, "hover": {}, "active": {}, "selected": {} },
        "_instanceName": "Back to list",
        "_children": [],
        "text": "חזור לרשימת המשמרות",
        "type": "primary",
        "onClick": [
          {
            "id": "evt_nav_back",
            "##eventHandlerType": "Navigate To",
            "parameters": { "url": "/shift-slots", "peek": false }
          }
        ]
      }
    ]
  }
}
